# Copy to .env.local and fill in your own values. Never commit that file.
# Next.js reads .env.local. Convex reads CLERK_JWT_ISSUER_DOMAIN from the
# Convex dashboard (Settings > Environment Variables), not from Next.js.

# Vercel AI Gateway. @ai-sdk/gateway reads this variable.
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# Apify token used by the Instagram scrapers.
APIFY_API_TOKEN=your-apify-api-token

# Tavily. Required for the orchestrator's web search tool.
TAVILY_API_KEY=your-tavily-api-key

# Mem0. Optional. Chat memory is skipped when this is unset.
MEM0_API_KEY=your_mem0_key

# Clerk. Use the test or live keys from your own Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Clerk Frontend API / issuer URL, for Convex auth.
# Shape: https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Written by `npx convex dev` for your own Convex project.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
